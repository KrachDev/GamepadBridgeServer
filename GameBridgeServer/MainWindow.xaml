<hc:Window x:Class="GameBridgeServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties="clr-namespace:GameBridgeServer.Properties"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:GameBridgeServer"
        mc:Ignorable="d"
        Title="GameBridge Server" 
        Height="600" Width="800"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded"
        Background="#FF1E1E1E">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AA000000" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Indicator Style -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="#FF666666"/>
        </Style>

        <!-- Info Text Style -->
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF00D4FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF1A1A1A" Offset="0"/>
                <GradientStop Color="#FF2A2A2A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF333333" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎮" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="GameBridge Server" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Connect your Gamepad Through Your Phone" FontSize="12" Foreground="#FFAAAAAA"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <hc:TabControl Grid.Row="1" TabStripPlacement="Top" Background="Transparent">

            <!-- Connection Tab -->
            <hc:TabItem Header="Connection" Foreground="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Server Control Panel -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Server Control" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                            <!-- IP Address Selection -->
                            <TextBlock Text="Network Interface:" Style="{StaticResource InfoText}" Margin="0,0,0,5"/>
                            <hc:ComboBox x:Name="NetworkInterfaceCombo" Margin="0,0,0,20" Height="35"/>

                            <!-- Server Actions -->
                            <Button x:Name="StartServerBTN" 
                                    Content="Start Server" 
                                    Height="45" 
                                    Margin="0,0,0,10"
                                    Click="StartServerBTN_Click"
                                    Background="#FF007ACC"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="14"/>

                            <Button x:Name="StopServerBTN" 
                                    Content="Stop Server" 
                                    Height="45"
                                    Click="StopServerBTN_Click"
                                    Background="#FFCC3300"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="14"/>

                            <!-- Connection Info -->
                            <Separator Margin="0,20,0,20" Background="#FF444444"/>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address:" Style="{StaticResource InfoText}" Margin="0,0,10,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IPAddressText" Text="Not Started" Style="{StaticResource ValueText}" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Style="{StaticResource InfoText}" Margin="0,0,10,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortText" Text="{Binding Source={x:Static properties:Settings_Designer.Default}, Path=ServerPortSetting}" Style="{StaticResource ValueText}" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Clients:" Style="{StaticResource InfoText}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClientCountText" Text="0" Style="{StaticResource ValueText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- QR Code & Connection Guide -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Connect Your Device" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                            
                            <!-- QR Code -->
                            <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <Image x:Name="QrCodeImage" Width="200" Height="200" Stretch="Uniform"/>
                            </Border>

                            <!-- Instructions -->
                            <TextBlock Text="Instructions:" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource InfoText}" LineHeight="20">
                                1. Install GameBridge app on your mobile device<LineBreak/>
                                2. Connect both devices to the same WiFi network<LineBreak/>
                                3. Scan the QR code or enter IP manually<LineBreak/>
                                4. Start playing with your mobile gamepad!
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </hc:TabItem>

            <!-- Settings Tab -->
            <hc:TabItem Header="Settings" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Controller Settings -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Controller Configuration" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Stick Settings -->
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Left Analog Stick" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <CheckBox Checked="InvertChecker_OnChecked" Unchecked="InvertChecker_OnChecked"
                                              Grid.Row="1" Grid.Column="0" 
                                              IsChecked="{Binding Source={x:Static properties:Settings_Designer.Default}, Path=LeftStickInvertX}" 
                                              x:Name="LeftStickInvertX" 
                                              Content="Invert X-Axis" 
                                              Foreground="#FFCCCCCC" Margin="0,0,10,5"/>

                                    <CheckBox Checked="InvertChecker_OnChecked" Unchecked="InvertChecker_OnChecked"
                                              Grid.Row="1" Grid.Column="1" 
                                              IsChecked="{Binding Source={x:Static properties:Settings_Designer.Default}, Path=LeftStickInvertY}" 
                                              x:Name="LeftStickInvertY" 
                                              Content="Invert Y-Axis" 
                                              Foreground="#FFCCCCCC" Margin="10,0,0,5"/>
                                    <!-- Right Stick Settings -->
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Right Analog Stick" FontWeight="Bold" Foreground="White" Margin="0,15,0,10"/>
                                    
                                    <CheckBox Grid.Row="3" Grid.Column="0" 
                                              IsChecked="{Binding Source={x:Static properties:Settings_Designer.Default}, Path=RightStickInvertX}" 
                                              x:Name="RightStickInvertX" 
                                              Content="Invert X-Axis" 
                                              Foreground="#FFCCCCCC" 
                                              Margin="0,0,10,0"
                                              Checked="InvertChecker_OnChecked" 
                                              Unchecked="InvertChecker_OnChecked"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" 
                                              IsChecked="{Binding Source={x:Static properties:Settings_Designer.Default}, Path=RightStickInvertY}" 
                                              x:Name="RightStickInvertY" 
                                              Content="Invert Y-Axis" 
                                              Foreground="#FFCCCCCC" 
                                              Margin="10,0,0,0"
                                              Checked="InvertChecker_OnChecked" 
                                              Unchecked="InvertChecker_OnChecked"/>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Vibration Test -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Vibration Test" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Motor:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="LeftMotorSlider" Minimum="0" Maximum="255" Value="0" Margin="0,0,10,10"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LeftMotorValue" Text="0" Style="{StaticResource ValueText}" Width="30" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Right Motor:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="RightMotorSlider" Minimum="0" Maximum="255" Value="0" Margin="0,0,10,10"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RightMotorValue" Text="0" Style="{StaticResource ValueText}" Width="30" Margin="0,0,0,10"/>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Button x:Name="TestVibrationBtn" Content="Test Vibration" Click="TestVibrationBtn_Click" Margin="0,0,10,0" Padding="15,8"/>
                                        <Button x:Name="StopVibrationBtn" Content="Stop" Click="StopVibrationBtn_Click" Padding="15,8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Settings -->
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Advanced Settings" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Port:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="0,0,15,10"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBox x:Name="ServerPortTextBox" Text="5000" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                        <TextBlock Name="ServerPortTextBoxWarrning" Visibility="Collapsed" Text="Bad Port" Foreground="Red" VerticalAlignment="Center" Margin="0,0,15,10"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Auto-start server:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="AutoStartCheckBox" Content="Start server when application launches" Foreground="#FFCCCCCC"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </hc:TabItem>

            <!-- Logs Tab -->
            <hc:TabItem Header="Logs" Foreground="White">
                <Border Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Activity Logs" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="Clear Logs" x:Name="ClearLogsBtn" Click="ClearLogsBtn_Click" Margin="20,0,0,0" Padding="10,5"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FF1A1A1A" Padding="10">
                            <TextBlock x:Name="LogsTextBlock" 
                                       Text="Server ready. Click 'Start Server' to begin..."
                                       TextWrapping="Wrap" 
                                       FontFamily="Consolas" 
                                       Foreground="#FF00FF00"
                                       FontSize="12"
                                       LineHeight="16"/>
                        </ScrollViewer>

                        <CheckBox Grid.Row="2" x:Name="AutoScrollLogsCheckBox" Content="Auto-scroll logs" 
                                  Foreground="#FFCCCCCC" IsChecked="True" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </hc:TabItem>

        </hc:TabControl>
    </Grid>
</hc:Window>